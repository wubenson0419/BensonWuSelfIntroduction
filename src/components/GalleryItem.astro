---
import { getImage } from "astro:assets";

export interface Props {
    src: string;
    title: string;
    desc: string;
    lazy?: boolean;
}

const { src, title, desc, lazy = true } = Astro.props;

// 動態優化 public/ 內的圖片
const optimizedImage = await getImage({
    src: src,
    width: 800,
    height: 600,
    format: 'webp'
});
---

<div class="gallery-item lightbox-trigger" data-img-src={src} data-title={title} data-description={desc}>
    <img 
        src={optimizedImage.src} 
        alt={title} 
        loading={lazy ? "lazy" : "eager"} 
        width="800"
        height="600"
    />
</div>
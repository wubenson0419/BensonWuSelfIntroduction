---
import { Image } from "astro:assets";

export interface Props {
    src: string;
    title: string;
    desc: string;
    lazy?: boolean;
}

const { src, title, desc, lazy = true } = Astro.props;
---

<div class="gallery-item lightbox-trigger" data-img-src={src} data-title={title} data-description={desc}>
    <Image
        src={src}
        alt={title}
        loading={lazy ? "lazy" : "eager"}
        fetchpriority={lazy ? "auto" : "high"}
        decoding="async"
        width={800}
        height={600}
        format="webp"
    />
</div>
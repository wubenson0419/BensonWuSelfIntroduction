---
import { photoUrls, type Photo } from "../utils/gallery";

export interface Props {
    photo: Photo;
    lazy?: boolean;
}

const { photo, lazy = true } = Astro.props;
const urls = await photoUrls(photo);
const label = photo.title || photo.albumLabel;
---

<a
    href={urls.large}
    class="gallery-item lightbox-trigger"
    data-img-src={urls.large}
    data-original={photo.src}
    data-title={photo.title}
    data-description={photo.desc}
    data-meta={photo.albumLabel}
    data-album={photo.album}
    data-label={label}
    aria-label={`查看照片：${label}`}
>
    <img
        src={urls.thumb}
        srcset={urls.srcset}
        sizes="(max-width: 1100px) 33vw, 360px"
        width={urls.width}
        height={urls.height}
        alt={label}
        loading={lazy ? "lazy" : "eager"}
        decoding="async"
    />
</a>

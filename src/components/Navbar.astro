---
// Navbar.astro
// Includes HTML from nav.html and logic from components.js

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
    // Basic match logic
    if (path === "/" && currentPath === "/") return true;
    if (path !== "/" && currentPath.includes(path)) return true;
    return false;
};
---

<div class="desktop-nav-container">
    <nav class="desktop-nav-capsule">
        <ul class="desktop-nav-links">
            <li>
                <a href="/" class={isActive("/") ? "is-current" : ""}>首頁</a>
            </li>
            <li>
                <a
                    href="/aboutme"
                    class={isActive("/aboutme") ? "is-current" : ""}>關於我</a>
            </li>
            <li>
                <a
                    href="/highlight"
                    class={isActive("/highlight") ? "is-current" : ""}
                    >精選作品</a>
            </li>
            <li>
                <a
                    href="/callme"
                    class={isActive("/callme") ? "is-current" : ""}>聯絡我</a>
            </li>
        </ul>
    </nav>
</div>

<button id="menu-toggle" aria-label="開啟/關閉菜單" class="mobile-only">
    <i id="menu-icon" class="fa-solid fa-list-ul"></i>
</button>
<nav id="main-nav" class="mobile-only">
    <ul>
        <li><a href="/" class={isActive("/") ? "is-current" : ""}>首頁</a></li>
        <li>
            <a href="/aboutme" class={isActive("/aboutme") ? "is-current" : ""}
                >關於我</a>
        </li>
        <li>
            <a
                href="/highlight"
                class={isActive("/highlight") ? "is-current" : ""}>精選作品</a>
        </li>
        <li>
            <a href="/callme" class={isActive("/callme") ? "is-current" : ""}
                >聯絡我</a>
        </li>
    </ul>
</nav>
<div id="menu-overlay" class="mobile-only"></div>

<script>
    function initializeMenu() {
        const menuToggle = document.getElementById("menu-toggle");
        const menuOverlay = document.getElementById("menu-overlay");
        const menuIcon = document.getElementById("menu-icon");

        if (!menuToggle || !menuIcon) return;

        menuToggle.addEventListener("click", () => {
            const isActive = document.body.classList.toggle("menu-active");
            if (isActive) {
                menuIcon.classList.replace("fa-list-ul", "fa-xmark");
            } else {
                menuIcon.classList.replace("fa-xmark", "fa-list-ul");
            }
        });

        if (menuOverlay) {
            menuOverlay.addEventListener("click", () => {
                document.body.classList.remove("menu-active");
                menuIcon.classList.replace("fa-xmark", "fa-list-ul");
            });
        }
    }

    document.addEventListener("astro:page-load", initializeMenu);
    // Execute on initial load as well
    initializeMenu();
</script>

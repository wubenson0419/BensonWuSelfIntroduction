---
import '../styles/style.css';
import '../styles/nav.css';
import '../styles/lightbox.css';
import '../styles/glass.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  /** true 時告訴搜尋引擎不要收錄（例如尚未公開的履歷頁） */
  noindex?: boolean;
}

const { title = "吳秉乾 - Benson Wu | Personal Website", noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- 不讓搜尋引擎把照片收進圖片搜尋，也聲明不同意 AI 訓練使用 -->
    <meta name="robots" content="noimageindex, noai, noimageai" />
    <meta name="description" content="吳秉乾的自介網站，展示個人作品、攝影集和聯絡方式。">

    <meta property="og:title" content="吳秉乾的自介網站">
    <meta property="og:description" content="一個從零開始，純手搓的自我介紹網站。">
    <meta property="og:image" content="https://bhwu.pages.dev/images/headportrait/myicon.webp">
    <meta property="og:url" content="https://bhwu.pages.dev">
    <meta property="og:type" content="website">
    <meta name="google-site-verification" content="DNEZQaTRX3U91vvFimb49qEBTfE01zcyzQN2f4USgB8" />
    <link rel="icon" type="image/webp" href="/images/headportrait/myicon.webp">

    <link rel="preload" href="/fonts/chiron-go-round-tc/woff2/vf/t0/lgc.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high">
    <link rel="stylesheet" href="/fonts/chiron-go-round-tc/css/vf.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_forward,arrow_upward,check,chevron_left,chevron_right,close,content_copy,emoji_events,expand_more,image,link,mail,photo_camera,school,send,sports_esports,workspace_premium&display=block" rel="stylesheet" />
    <meta name="theme-color" content="#0a0a0c">
    <slot name="head" />

    <!-- Cloudflare Web Analytics -->
    <!-- Add script here -->
</head>
<body>
    <a class="skip-link" href="#content">跳到主要內容</a>
    <div class="bg-grid" aria-hidden="true"></div>
    <Navbar />

    <div class="smooth-scroll-wrapper">
        <div id="content">
            <slot />
        </div>
        <Footer />
    </div>

    <button type="button" class="back-to-top glass glass-press" aria-label="回到頂部" hidden>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
    </button>

    <!-- Liquid Glass 折射濾鏡（僅 Chromium 會套用到 backdrop-filter） -->
    <svg class="sr-only" aria-hidden="true" width="0" height="0">
        <filter id="lg-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise" />
            <feGaussianBlur in="noise" stdDeviation="2" result="soft" />
            <feDisplacementMap in="SourceGraphic" in2="soft" scale="28" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <Lightbox />

    <script>
        import { initAnimations, initUI } from '../scripts/animations';
        import { protectImages } from '../scripts/protect';
        protectImages();
        initUI();
        initAnimations();
    </script>
</body>
</html>

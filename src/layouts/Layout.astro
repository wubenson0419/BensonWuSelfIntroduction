---
import '../styles/style.css';
import '../styles/nav.css';
import '../styles/lightbox.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE_DATA } from '../data/siteData';

interface Props {
  title?: string;
}

const { title = "吳秉乾 - Benson Wu | Personal Website" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content="吳秉乾的自介網站，展示個人作品、攝影集和聯絡方式。">

    <meta property="og:title" content="吳秉乾的自介網站">
    <meta property="og:description" content="一個從零開始，純手搓的自我介紹網站。">
    <meta property="og:image" content="https://bhwu.pages.dev/images/headportrait/myicon.webp">
    <meta property="og:url" content="https://bhwu.pages.dev">
    <meta property="og:type" content="website">
    <meta name="google-site-verification" content="DNEZQaTRX3U91vvFimb49qEBTfE01zcyzQN2f4USgB8" />
    <link rel="icon" type="image/webp" href="/images/headportrait/myicon.webp">

    <link rel="preload" href="/fonts/chiron-go-round-tc/woff2/vf/t0/lgc.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high">
    <link rel="stylesheet" href="/fonts/chiron-go-round-tc/css/vf.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <meta name="theme-color" content="#0a0a0c">
    
    <!-- Cloudflare Web Analytics -->
    <!-- Add script here -->
</head>
<body>
    <Navbar />

    <div class="smooth-scroll-wrapper">
        <slot />
        <Footer />
    </div>

    <Lightbox />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
    
    <script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
        // 確保 GSAP 已載入
        if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        gsap.registerPlugin(ScrollTrigger);

        // --- Gallery Items 動畫 ---
        var animateGalleryItems = function() {
            var galleryItems = gsap.utils.toArray('.gallery-item');
            if (galleryItems.length === 0) return;

            galleryItems.forEach(function(item, i) {
                if (item.dataset.galleryAnimated === 'true') return;
                item.dataset.galleryAnimated = 'true';

                gsap.from(item, {
                    scrollTrigger: {
                        trigger: item,
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    },
                    y: 60,
                    opacity: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    delay: (i % 4) * 0.1
                });
            });
            ScrollTrigger.refresh();
        };

        // --- 1. Hero 區塊進場動畫 ---
        if (document.querySelector('.hero-title')) {
            var heroTl = gsap.timeline();
            heroTl.from(".hero-title", {
                y: 80,
                opacity: 0,
                duration: 1.2,
                ease: "power3.out",
                delay: 0.2
            })
            .from(".hero-subtitle", {
                y: 50,
                opacity: 0,
                duration: 1,
                ease: "power3.out"
            }, "-=0.8")
            .from(".hero-cta .btn", {
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: "power2.out"
            }, "-=0.6")
            .from(".hero-image-container", {
                scale: 0.8,
                opacity: 0,
                duration: 1.2,
                ease: "elastic.out(1, 0.7)"
            }, "-=0.8");
        }

        // --- 2. About Me (Bento Box) 滾動進場動畫 ---
        var bentoCards = gsap.utils.toArray('.bento-card');
        if (bentoCards.length > 0) {
            bentoCards.forEach(function(card, i) {
                gsap.from(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    },
                    y: 60,
                    opacity: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    delay: i * 0.1
                });
            });
        }

        // --- 3. Gallery Header 動畫 ---
        var galleryHeader = document.querySelector(".gallery-header");
        if (galleryHeader) {
            gsap.from(galleryHeader, {
                scrollTrigger: {
                    trigger: ".gallery-section",
                    start: "top 80%"
                },
                y: 30,
                opacity: 0,
                duration: 0.6
            });
        }

        // --- 3.5 Gallery Items 畫廊圖片滑進滑出動畫 ---
        document.addEventListener('gallery:rendered', animateGalleryItems);
        animateGalleryItems();

        // --- 4. 磁吸按鈕效果 (Magnetic Buttons) ---
        var magnets = document.querySelectorAll('.magnetic-btn');
        magnets.forEach(function(btn) {
            var moveX = gsap.quickTo(btn, "x", { duration: 0.25, ease: "power2.out" });
            var moveY = gsap.quickTo(btn, "y", { duration: 0.25, ease: "power2.out" });
            var frameId = null;

            btn.addEventListener('mousemove', function(e) {
                if (frameId) cancelAnimationFrame(frameId);
                frameId = requestAnimationFrame(function() {
                    var rect = btn.getBoundingClientRect();
                    moveX((e.clientX - rect.left - rect.width / 2) * 0.3);
                    moveY((e.clientY - rect.top - rect.height / 2) * 0.3);
                    frameId = null;
                });
            });

            btn.addEventListener('mouseleave', function() {
                if (frameId) cancelAnimationFrame(frameId);
                moveX(0);
                moveY(0);
            });
        });

        // --- 6. 通用 data-scroll="fade-up" 動畫 ---
        var scrollElements = gsap.utils.toArray('[data-scroll="fade-up"]');
        if (scrollElements.length > 0) {
            scrollElements.forEach(function(el) {
                if (el.classList.contains('bento-card')) return;
                gsap.from(el, {
                    scrollTrigger: {
                        trigger: el,
                        start: "top 95%",
                        toggleActions: "play none none reverse"
                    },
                    y: 35,
                    opacity: 0,
                    duration: 0.7,
                    ease: "power2.out"
                });
            });
        }

        // 通知 GSAP 重整 ScrollTrigger
        requestAnimationFrame(function() { ScrollTrigger.refresh(); });
    });
    </script>
</body>
</html>

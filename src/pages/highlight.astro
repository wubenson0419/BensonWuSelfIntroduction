---
import Layout from "../layouts/Layout.astro";
import { SITE_DATA } from "../data/siteData";
import GalleryItem from "../components/GalleryItem.astro";
import AlbumFilter from "../components/AlbumFilter.astro";
import { PHOTOS } from "../utils/gallery";

const { copy } = SITE_DATA;
---

<Layout title="Photos - Benson Wu">
    <main class="container page">
        <header class="page-header">
            <p class="eyebrow"><span class="prompt">$</span> cat photo.md</p>
            <h1 class="page-title" data-scramble>{copy.photos.pageTitle}</h1>
            <p class="section-sub">{copy.photos.pageSub}</p>
        </header>

        <AlbumFilter />

        <section class="photo-grid" aria-label="照片">
            {PHOTOS.map((photo, index) => <GalleryItem photo={photo} lazy={index > 8} />)}
        </section>

        <p class="page-note">
            <a href="https://wubenson0419.github.io/BensonWu_self-introduction/highlight.html" class="text-link">
                若想了解更多內容，可以去舊網站看看
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
        </p>
    </main>
</Layout>

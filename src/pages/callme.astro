---
import Layout from "../layouts/Layout.astro";
import { SITE_DATA } from "../data/siteData";
import SocialLinks from "../components/SocialLinks.astro";

const { profile, copy } = SITE_DATA;
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent("你好，想與您聯繫")}&body=${encodeURIComponent("您的姓名：\n聯絡電話：\n問題描述：\n")}`;
---

<Layout title={`Contact - ${profile.nickname}`}>
    <main class="container page">
        <section class="contact-card" data-scroll="fade-up">
            <div class="contact-avatar-wrapper">
                <img
                    src={profile.avatarSrc}
                    alt={profile.name}
                    class="contact-avatar"
                    width="112"
                    height="112"
                    loading="eager"
                    decoding="async"
                />
            </div>
            <p class="eyebrow"><span class="prompt">$</span> ping bensonwu -t</p>
            <h1 class="page-title" data-scramble>{copy.contactPage.title}</h1>
            <p class="section-sub">{copy.contactPage.subtitle}</p>

            <div class="email-box">
                <span class="material-symbols-outlined" aria-hidden="true">mail</span>
                <a href={mailto} class="email-address">{profile.email}</a>
                <button type="button" class="icon-btn" id="copy-email" data-email={profile.email} aria-label="複製 Email">
                    <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                </button>
            </div>
            <p class="copy-status" id="copy-status" aria-live="polite"></p>

            <a href={mailto} class="btn btn-primary magnetic-btn btn-block">
                {copy.contactPage.sendButton} <span class="material-symbols-outlined" aria-hidden="true">send</span>
            </a>

            <div class="contact-divider"><span>{copy.contactPage.socialLabel}</span></div>
            <SocialLinks variant="icons" />
        </section>
    </main>
</Layout>

<script>
    /**
     * 複製文字。navigator.clipboard 只能在 HTTPS 或 localhost 使用，
     * 用手機連電腦 IP（http://192.168.x.x）測試時會失敗，所以退回舊的 execCommand 作法。
     */
    async function copyText(text: string): Promise<boolean> {
        if (navigator.clipboard && window.isSecureContext) {
            try {
                await navigator.clipboard.writeText(text);
                return true;
            } catch {
                /* 改用下面的備援 */
            }
        }
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.cssText = "position:fixed;top:0;left:0;opacity:0;";
        document.body.append(area);
        area.select();
        area.setSelectionRange(0, text.length); // iOS
        let ok = false;
        try {
            ok = document.execCommand("copy");
        } catch {
            ok = false;
        }
        area.remove();
        return ok;
    }

    const btn = document.getElementById("copy-email") as HTMLButtonElement | null;
    const status = document.getElementById("copy-status");
    btn?.addEventListener("click", async () => {
        const icon = btn.querySelector(".material-symbols-outlined");
        const ok = await copyText(btn.dataset.email ?? "");
        if (ok && icon) icon.textContent = "check";
        if (status) status.textContent = ok ? "已複製到剪貼簿" : "複製失敗，請手動選取";
        setTimeout(() => {
            if (icon) icon.textContent = "content_copy";
            if (status) status.textContent = "";
        }, 2000);
    });
</script>

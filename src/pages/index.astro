---
import Layout from "../layouts/Layout.astro";
import { SITE_DATA } from "../data/siteData";
import SocialLinks from "../components/SocialLinks.astro";
import RandomPhotos from "../components/RandomPhotos.astro";
import { PHOTOS } from "../utils/gallery";

const { profile, interests, copy } = SITE_DATA;
---

<Layout title={`${profile.name} - ${profile.nickname} | Personal Website`}>
    <!-- Hero：置中對稱 -->
    <header class="hero-section container">
        <div class="hero-image-container">
            <div class="hero-image-mask">
                <img
                    src={profile.avatarSrc}
                    alt={profile.name}
                    class="hero-image"
                    width="400"
                    height="400"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </div>
        </div>
        <p class="eyebrow hero-eyebrow"><span class="prompt">$</span> whoami</p>
        <h1 class="hero-title">
            Hello, I'm <span class="accent-text" data-scramble>{profile.nickname}</span>
        </h1>
        <p class="hero-subtitle">
            <span class="typewriter" data-roles={JSON.stringify(profile.roles)}>
                <span class="typewriter-text" set:html={profile.heroSubtitle} />
            </span><span class="caret" aria-hidden="true"></span>
        </p>
        <div class="hero-cta">
            <a href="/aboutme" class="btn btn-primary magnetic-btn">
                關於我 <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
            <a href="/callme" class="btn btn-outline magnetic-btn">聯絡我</a>
        </div>
    </header>

    <main class="container">
        <!-- About：2×2 等高 -->
        <section id="about" class="section" aria-labelledby="about-heading">
            <div class="section-head">
                <h2 id="about-heading" class="section-heading" data-scramble>About Me</h2>
            </div>

            <div class="bento-grid">
                <div class="panel" data-scroll="fade-up">
                    <h3 class="panel-title">Profile</h3>
                    <dl class="fact-list">
                        <div><dt>暱稱</dt><dd>{profile.name}</dd></div>
                        <div><dt>英文</dt><dd>{profile.nickname}</dd></div>
                        <div><dt>身分</dt><dd>{profile.role}</dd></div>
                    </dl>
                </div>
                <div class="panel" data-scroll="fade-up">
                    <h3 class="panel-title">Education</h3>
                    <dl class="fact-list">
                        <div><dt>學校</dt><dd>{profile.school}</dd></div>
                        <div><dt>科系</dt><dd>{profile.major}</dd></div>
                        <div><dt>狀態</dt><dd><span class="status">{profile.status}</span></dd></div>
                    </dl>
                </div>
                <div class="panel" data-scroll="fade-up">
                    <h3 class="panel-title">Interests</h3>
                    <ul class="tags">
                        {interests.map((interest) => <li class="tag">{interest}</li>)}
                    </ul>
                </div>
                <div class="panel" data-scroll="fade-up">
                    <h3 class="panel-title">Connect</h3>
                    <SocialLinks variant="icons" />
                </div>
            </div>

            <div class="section-foot">
                <a href="/aboutme" class="text-link">
                    看我的經歷 <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
        </section>

        <!-- Photos：2 排 × 3 張，隨機 -->
        <section id="gallery" class="section" aria-labelledby="works-heading">
            <div class="section-head">
                <h2 id="works-heading" class="section-heading" data-scramble>{copy.photos.homeTitle}</h2>
                <p class="section-sub">{copy.photos.homeSub}</p>
            </div>

            <RandomPhotos />

            <div class="section-foot">
                <a href="/highlight" class="text-link">
                    查看全部 {PHOTOS.length} 張 <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
        </section>

        <!-- Contact CTA -->
        <section id="contact" class="section">
            <div class="cta-band" data-scroll="fade-up">
                <h2 class="section-heading" data-scramble>{copy.contactCta.title}</h2>
                <p class="section-sub">{copy.contactCta.text}</p>
                <a href="/callme" class="btn btn-primary magnetic-btn">
                    {copy.contactCta.button} <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
        </section>
    </main>
</Layout>
